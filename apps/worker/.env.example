# No API key lives here. @github/copilot-sdk authenticates via the bundled
# Copilot CLI's own stored login (run `gh auth login`, or `copilot auth login` if
# you have the standalone CLI) or one of the GH_TOKEN / GITHUB_TOKEN /
# COPILOT_GITHUB_TOKEN env vars, checked in that order. Nothing in this codebase
# ever reads or stores the token directly - see src/agentRunner.ts.
#
# Requires an org GitHub Copilot license with the "Anthropic Claude" policy
# enabled by an admin (Business/Enterprise) - confirm with
# `gh auth token --user <you> | ...` fed into scripts/smoke-test.ts if unsure.

# Path to the reference framework repo (Demo-Test-Automation-Framework) that
# .claude/skills/test-automation-framework/SKILL.md and references/templates/ are read from.
# Defaults to a sibling folder next to this repo if unset.
FRAMEWORK_REPO_PATH=

# Absolute path to the folder containing mvn / mvn.cmd. Left empty, the agent's Bash
# tool must already have `mvn` on PATH. Set this if Maven is only installed locally
# (e.g. the apache-maven-3.9.9 download used to build Demo-Test-Automation-Framework).
MAVEN_BIN_DIR=C:\Users\admin\Downloads\apache-maven-3.9.9\bin

# Preferred model id, tried first ahead of src/copilotModel.ts's own fallback list.
# Leave unset to just use that fallback list. Must be one of the ids your account's
# `client.listModels()` actually returns - see src/copilotModel.ts's comment on why
# this isn't hardcoded.
AGENT_MODEL=

# GitHub's own Copilot spend unit (AI Credits), not USD - there's no direct
# equivalent to a per-run USD budget cap. Leave unset for no SDK-enforced limit.
AGENT_MAX_AI_CREDITS=

# Wall-clock cap per generation session, passed straight to sendAndWait's timeout.
AGENT_TIMEOUT_MS=900000

# Express server port (Phase 1 API mode only; irrelevant for the CLI).
PORT=4000
