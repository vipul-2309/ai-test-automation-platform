{
  "name": "ai-test-automation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 generation engine: submits project name/app URL/credentials/test-case sheet, runs a Claude Agent SDK session grounded in the Demo-Test-Automation-Framework skill, returns a downloadable framework-compliant project zip.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "generate": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
